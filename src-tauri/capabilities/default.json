{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main, panel, and house windows",
  "windows": ["main", "panel", "house"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-set-resizable",
    "core:window:allow-outer-position",
    "core:window:allow-primary-monitor",
    "core:window:allow-current-monitor",
    "core:window:allow-available-monitors",
    "core:window:allow-scale-factor",
    "shell:allow-open",
    "opener:allow-open-url",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "omo",
          "cmd": "omo",
          "args": true,
          "sidecar": false
        },
        {
          "name": "omo-bun",
          "cmd": "$HOME/.bun/bin/omo",
          "args": true,
          "sidecar": false
        },
        {
          "name": "omo-homebrew",
          "cmd": "/opt/homebrew/bin/omo",
          "args": true,
          "sidecar": false
        },
        {
          "name": "omo-local",
          "cmd": "$HOME/.local/bin/omo",
          "args": true,
          "sidecar": false
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "omo",
          "cmd": "omo",
          "args": true,
          "sidecar": false
        },
        {
          "name": "omo-bun",
          "cmd": "$HOME/.bun/bin/omo",
          "args": true,
          "sidecar": false
        },
        {
          "name": "omo-homebrew",
          "cmd": "/opt/homebrew/bin/omo",
          "args": true,
          "sidecar": false
        },
        {
          "name": "omo-local",
          "cmd": "$HOME/.local/bin/omo",
          "args": true,
          "sidecar": false
        }
      ]
    },
    {
      "identifier": "shell:allow-stdin-write",
      "allow": [
        {
          "name": "omo",
          "cmd": "omo",
          "args": true,
          "sidecar": false
        },
        {
          "name": "omo-bun",
          "cmd": "$HOME/.bun/bin/omo",
          "args": true,
          "sidecar": false
        },
        {
          "name": "omo-homebrew",
          "cmd": "/opt/homebrew/bin/omo",
          "args": true,
          "sidecar": false
        },
        {
          "name": "omo-local",
          "cmd": "$HOME/.local/bin/omo",
          "args": true,
          "sidecar": false
        }
      ]
    },
    {
      "identifier": "shell:allow-kill",
      "allow": [
        {
          "name": "omo",
          "cmd": "omo",
          "args": true,
          "sidecar": false
        },
        {
          "name": "omo-bun",
          "cmd": "$HOME/.bun/bin/omo",
          "args": true,
          "sidecar": false
        },
        {
          "name": "omo-homebrew",
          "cmd": "/opt/homebrew/bin/omo",
          "args": true,
          "sidecar": false
        },
        {
          "name": "omo-local",
          "cmd": "$HOME/.local/bin/omo",
          "args": true,
          "sidecar": false
        }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$RESOURCE/**" },
        { "path": "$APPCONFIG/**" },
        { "path": "$APPDATA/**" }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$RESOURCE/**" },
        { "path": "$APPDATA/**" }
      ]
    }
  ]
}
